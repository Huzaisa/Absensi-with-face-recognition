# Mulai dari base image Debian + Node
FROM node:18-bullseye

# Install Python dan pip
RUN apt-get update && apt-get install -y python3 python3-pip

# Set working directory
WORKDIR /app

# Copy semua file project
COPY . .

# Install dependencies Node.js
RUN npm install

# Install dependencies Python
RUN pip3 install -r face-recognition-api/requirements.txt

# Prisma: generate client
RUN npx prisma generate

# Jalankan FastAPI (port 8000) dan Node.js (port 3000) secara paralel
# Gunakan 'concurrently' (install global)
RUN npm install -g concurrently

# Command untuk menjalankan dua server (Node + Python)
CMD concurrently \
  "uvicorn face-recognition-api.main:app --host 0.0.0.0 --port 8000" \
  "node src/app.js"
